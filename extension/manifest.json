{
  "manifest_version": 3,
  "name": "Proxy App",
  "description": "Sends this browser profile through Proxy App. Other profiles keep their normal connection.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["proxy", "storage", "alarms", "privacy"],
  "host_permissions": ["http://127.0.0.1/*", "https://ipwho.is/*", "https://api.ipify.org/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Proxy App",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
